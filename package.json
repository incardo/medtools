{
  "name": "medtools",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "npm test -w packages/engine",
    "typecheck": "tsc -p packages/engine && tsc -p apps/web",
    "deploy": "npm run deploy -w apps/web"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.142.0"
  }
}
